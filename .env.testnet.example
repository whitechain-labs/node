# Whitechain network: folder name under artifacts/ (mainnet | testnet)
WHITECHAIN_NETWORK=testnet

# Public IP advertised for op-reth / op-node P2P
PUBLIC_IP=<REAL_PUBLIC_IP>

# Public Whitechain RPC – transaction-forwarding target
WHITECHAIN_PUBLIC_RPC=https://rpc-bootstrap.testnet.whitechain.io

# Ethereum L1 RPC endpoint (operator-provided)
L1_RPC_URL=

# Ethereum L1 Beacon endpoint (operator-provided)
L1_BEACON_URL=

# L1 provider kind: basic | alchemy | quicknode | infura | ...
L1_RPC_KIND=basic


# Static op-node peer multiaddr (optional)
WHITECHAIN_PUBLIC_OP_NODE_P2P=/dns4/bootstrap.testnet.whitechain.io/tcp/9222/p2p/16Uiu2HAm9yHtetziD4nMdgWQmPPVHf47rRcpFE3wDpZjYXnWHP7u

# Trusted reth enode for snap sync (required for full-snap-node)
WHITECHAIN_RETH_TRUSTED_PEERS=enode://3cd9d50bebee31c868177eba083643009bb98d753dd9886a1d3137d7da7669cb7c0d9a03966f18862b4277f9e7361d3f32f55b5c564a142c6c651e63af93d9ac@bootstrap.testnet.whitechain.io:30303

# Image pinning (optional; defaults in docker-compose.yml)
# OP_RETH_IMAGE=public.ecr.aws/l8q8a0h5/op-reth:v2.3.3
# OP_NODE_IMAGE=public.ecr.aws/l8q8a0h5/op-node:v1.19.3

# Host port overrides (optional; shared across profiles, one node at a time)
# HOST_HTTP_PORT=8545
# HOST_WS_PORT=8546
# HOST_EL_P2P_PORT=30303
# HOST_OP_NODE_P2P_PORT=9222
# HOST_OP_NODE_RPC_PORT=9545

# op-reth HTTP RPC namespaces, all profiles (comma-separated, no spaces).
# Default is the read-only set. Adding debug,trace,txpool,reth turns the
# archive node into a tracing endpoint: only do it behind a reverse proxy that
# allowlists methods and rate-limits clients.
HTTP_API=eth,net,web3,rpc

# op-reth WebSocket RPC namespaces, all profiles. Same rules as HTTP_API above.
WS_API=eth,net,web3,rpc
