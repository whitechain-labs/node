# Whitechain network: folder name under artifacts/ (mainnet | testnet)
WHITECHAIN_NETWORK=mainnet

# Public IP advertised for op-reth / op-node P2P
PUBLIC_IP=0.0.0.0

# Public Whitechain RPC – transaction-forwarding target
WHITECHAIN_PUBLIC_RPC=

# Ethereum L1 RPC endpoint (operator-provided)
L1_RPC_URL=

# Ethereum L1 Beacon endpoint (operator-provided)
L1_BEACON_URL=

# L1 provider kind: basic | alchemy | quicknode | infura | ...
L1_RPC_KIND=basic

# Trusted reth enode for snap sync (required for full-snap-node)
WHITECHAIN_RETH_TRUSTED_PEERS=<mainnet_op_reth_enode>

# Static op-node peer multiaddr (optional)
WHITECHAIN_PUBLIC_OP_NODE_P2P=<mainnet_op_node_static_peer>

# Image pinning (optional; defaults in docker-compose.yml)
# OP_RETH_IMAGE=public.ecr.aws/l8q8a0h5/op-reth:v2.3.3
# OP_NODE_IMAGE=public.ecr.aws/l8q8a0h5/op-node:v1.19.3

# Host port overrides (optional; shared across profiles, one node at a time)
# HOST_HTTP_PORT=18545
# HOST_WS_PORT=18546
# HOST_EL_P2P_PORT=30303
# HOST_OP_NODE_P2P_PORT=19222
# HOST_OP_NODE_RPC_PORT=9545
